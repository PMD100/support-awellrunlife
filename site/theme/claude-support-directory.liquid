{%- comment -%}
  GA · Support Directory
  =====================

  Homepage section pointing to the grief support group directory.

  WHY THIS IS A THEME SECTION AND NOT A "CUSTOM LIQUID" BLOCK
  ----------------------------------------------------------
  The first version of this was written as a paste-in Custom Liquid block. That was
  wrong. This store runs a vintage (pre-Online-Store-2.0) theme: templates/index.liquid
  is a hardcoded list of section tags, so the theme editor offers no "Add section"
  button on the home page at all. There is nowhere to paste it.

  So it ships the way every other homepage band ships - a section file, referenced by
  name from templates/index.liquid.

  WHY IT LOOKS THE WAY IT DOES
  ----------------------------
  It sits directly below "Carry it. Gift it. Believe in it." - the store's hardest sell.
  Two centred dark gold-buttoned bands back to back would read as a second pitch, and
  would put a free public service in competition with the product it funds.

  So this one is deliberately quieter than the CTA above it:
    * A hairline gold rule and a deeper ground (#0a0e16) separate it from the CTA.
    * The button is outlined, not the filled gold gradient. Clearly clickable, plainly
      subordinate. A grieving reader still finds it; a shopping reader isn't pulled away.
    * Type is a size down from the CTA throughout.

  The copy opens with the reader's situation, not ours. It states what the directory
  withholds - no ads, no signup, no paid placement - rather than boasting about what it
  holds. There are no listing counts, because counts go stale and this section should
  never need maintaining. And 988 appears here, on the homepage, because someone in real
  distress may never click through.

  Palette, faces and the cg-reveal scroll animation are inherited from the surrounding
  sections so this reads as part of the page rather than an insert.
{%- endcomment -%}

<section class="cg-dir" id="cg-dir">
  <div class="cg-dir__inner">
    <p class="cg-dir__eyebrow cg-reveal">{{ section.settings.eyebrow }}</p>
    <h2 class="cg-dir__title cg-reveal cg-d1">{{ section.settings.heading }}</h2>
    <p class="cg-dir__p cg-reveal cg-d2">{{ section.settings.body }}</p>
    <p class="cg-dir__quiet cg-reveal cg-d2">{{ section.settings.withholds }}</p>
    <div class="cg-reveal cg-d3">
      <a class="cg-dir__btn" href="{{ section.settings.btn_url }}">{{ section.settings.btn_label }}</a>
    </div>
    <p class="cg-dir__fine cg-reveal cg-d3">{{ section.settings.fine }}</p>
  </div>
</section>

<style>
.cg-dir{position:relative;background:#0a0e16;padding:104px 24px 116px;text-align:center}
.cg-dir::before{content:"";position:absolute;left:50%;top:0;transform:translateX(-50%);width:min(760px,86%);height:1px;background:linear-gradient(90deg,transparent,rgba(217,168,102,.42),transparent)}
.cg-dir__inner{max-width:600px;margin:0 auto}
.cg-dir__eyebrow{font:500 12px/1.6 'Inter',sans-serif;letter-spacing:.34em;text-transform:uppercase;color:#d9a866;margin:0 0 22px}
.cg-dir__title{font-family:'Fraunces',serif;font-weight:340;font-size:clamp(28px,3.4vw,42px);line-height:1.18;color:#f4ead9;margin:0 0 20px}
.cg-dir__title em{font-style:italic;color:#e0b380}
.cg-dir__p{font:300 16px/1.85 'Inter',sans-serif;color:rgba(244,234,217,.74);margin:0 0 14px}
.cg-dir__quiet{font:300 14px/1.8 'Inter',sans-serif;color:rgba(244,234,217,.48);margin:0 0 38px}
.cg-dir__btn{display:inline-flex;align-items:center;gap:.6em;font:500 12.5px/1 'Inter',sans-serif;letter-spacing:.22em;text-transform:uppercase;color:#e0b380;background:transparent;border:1px solid rgba(224,179,128,.55);padding:1.1em 2.1em;border-radius:2px;text-decoration:none;transition:background .35s ease,border-color .35s ease,transform .35s ease}
.cg-dir__btn:hover,.cg-dir__btn:focus{background:rgba(224,179,128,.1);border-color:rgba(224,179,128,.9);color:#f0cfa4;text-decoration:none;transform:translateY(-2px)}
.cg-dir__btn:focus-visible{outline:2px solid #f4ead9;outline-offset:3px}
.cg-dir__fine{font:400 12.5px/1.85 'Inter',sans-serif;letter-spacing:.04em;color:rgba(244,234,217,.44);margin:34px 0 0}
.cg-dir__fine a{color:#d9a866;text-decoration:underline;text-underline-offset:2px}
@media (max-width:760px){.cg-dir{padding:76px 20px 84px}}
.cg-reveal{opacity:0;transform:translateY(26px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
.cg-reveal.cg-in{opacity:1;transform:none}
.cg-d1{transition-delay:.12s}.cg-d2{transition-delay:.24s}.cg-d3{transition-delay:.36s}
@media (prefers-reduced-motion:reduce){.cg-reveal{transition:none;opacity:1;transform:none}}
</style>

<script>
(function(){
  function init(){
    var els=document.querySelectorAll('.cg-reveal:not([data-cgr])');var i;
    if(!('IntersectionObserver' in window)){for(i=0;i<els.length;i++){els[i].classList.add('cg-in');els[i].setAttribute('data-cgr','1');}return;}
    window.__cgio=window.__cgio||new IntersectionObserver(function(es){for(var j=0;j<es.length;j++){if(es[j].isIntersecting){es[j].target.classList.add('cg-in');window.__cgio.unobserve(es[j].target);}}},{threshold:0.12,rootMargin:'0px 0px -40px 0px'});
    for(i=0;i<els.length;i++){els[i].setAttribute('data-cgr','1');window.__cgio.observe(els[i]);}
  }
  if(document.readyState!=='loading'){init()}else{document.addEventListener('DOMContentLoaded',init)}
})();
</script>

{% schema %}
{
  "name": "GA · Support Directory",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A Free Public Service"},
    {"type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Looking for a grief <em>support group</em>?"},
    {"type": "textarea", "id": "body", "label": "Body", "default": "We keep a free directory of local bereavement groups — who each one is for, whether it costs anything, and the date we last checked it was still meeting."},
    {"type": "text", "id": "withholds", "label": "Second line", "default": "No advertising. Nothing behind an email signup. Placement is never for sale."},
    {"type": "text", "id": "btn_label", "label": "Button label", "default": "Find a Support Group"},
    {"type": "text", "id": "btn_url", "label": "Button URL", "default": "/pages/support-center-sponsored-by-a-well-run-life"},
    {"type": "textarea", "id": "fine", "label": "Fine print (HTML allowed)", "default": "A free public service from A Well Run Life.<br>If you are in crisis, call or text <a href=\"tel:988\">988</a> at any hour."}
  ],
  "presets": [{"name": "GA · Support Directory", "category": "Claude Redesign"}]
}
{% endschema %}
